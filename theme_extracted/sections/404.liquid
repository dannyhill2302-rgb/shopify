<div class="page-404">

  <div class="page-404__hero">
    <h1 class="page-404__code">404</h1>
    <h2 class="page-404__heading">{{ section.settings.heading | default: 'Oops! Page not found' }}</h2>
    <p class="page-404__subtext">{{ section.settings.subtext | default: "The page you're looking for doesn't exist. Check out our products below!" }}</p>
    <a href="{{ routes.root_url }}" class="page-404__btn button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      {{ section.settings.button_text | default: 'Back to Home' }}
    </a>
  </div>

  {%- assign featured_col = collections[section.settings.featured_collection] -%}
  {%- assign products_to_show = featured_col.products | sort: 'best_selling' -%}

  {% if featured_col != blank and featured_col.products.size > 0 %}
  <div class="page-404__carousel-section">
    <h2 class="page-404__section-title">{{ section.settings.carousel_heading | default: 'Featured Products' }}</h2>

    <div class="page-404__carousel" data-carousel>
      <button class="page-404__carousel-btn page-404__carousel-btn--prev" data-carousel-prev aria-label="Previous">&#8249;</button>

      <div class="page-404__carousel-track-wrapper">
        <ul class="page-404__carousel-track" data-carousel-track>
          {% for product in featured_col.products limit: section.settings.products_count %}
          <li class="page-404__carousel-slide">
            <a href="{{ product.url }}" class="page-404__product-card">
              <div class="page-404__product-img-wrapper">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {% endif %}
              </div>
              <p class="page-404__product-title">{{ product.title }}</p>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>

      <button class="page-404__carousel-btn page-404__carousel-btn--next" data-carousel-next aria-label="Next">&#8250;</button>
    </div>

    <div class="page-404__dots" data-carousel-dots></div>
  </div>
  {% endif %}

  <div class="page-404__categories-section">
    <h2 class="page-404__section-title">{{ section.settings.categories_heading | default: 'Shop by Category' }}</h2>
    <div class="page-404__categories">

      {% for i in (1..3) %}
        {% assign cat_title_key = 'cat' | append: i | append: '_title' %}
        {% assign cat_col_key   = 'cat' | append: i | append: '_collection' %}
        {% assign cat_img_key   = 'cat' | append: i | append: '_image' %}
        {% assign cat_title = section.settings[cat_title_key] %}
        {% assign cat_col   = collections[section.settings[cat_col_key]] %}
        {% assign cat_img   = section.settings[cat_img_key] %}

        {% if cat_col != blank or cat_img != blank %}
        <a
          href="{% if cat_col != blank %}{{ cat_col.url }}{% else %}{{ routes.root_url }}{% endif %}"
          class="page-404__cat-tile"
        >
          {% if cat_img != blank %}
            <img
              src="{{ cat_img | img_url: '600x600', crop: 'center' }}"
              alt="{{ cat_title | escape }}"
              loading="lazy"
              class="page-404__cat-img"
            >
          {% elsif cat_col.image %}
            <img
              src="{{ cat_col.image | img_url: '600x600', crop: 'center' }}"
              alt="{{ cat_title | escape }}"
              loading="lazy"
              class="page-404__cat-img"
            >
          {% endif %}
          <span class="page-404__cat-label">{{ cat_title }}</span>
        </a>
        {% endif %}
      {% endfor %}

    </div>
  </div>

</div>

<style>
  .page-404 {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 60px;
    text-align: center;
  }
  .page-404__hero {
    padding: 60px 20px 50px;
  }
  .page-404__code {
    font-size: 7rem;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 12px;
    color: #111;
  }
  .page-404__heading {
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0 0 12px;
  }
  .page-404__subtext {
    color: #666;
    margin: 0 0 28px;
    font-size: 1rem;
  }
  .page-404__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: #111;
    color: #fff;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s;
  }
  .page-404__btn:hover { background: #333; color: #fff; }

  /* ── Carousel ── */
  .page-404__carousel-section { margin-bottom: 60px; }
  .page-404__section-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0 0 24px;
  }
  .page-404__carousel {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
  }
  .page-404__carousel-track-wrapper {
    flex: 1;
    overflow: hidden;
  }
  .page-404__carousel-track {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: transform 0.35s ease;
  }
  .page-404__carousel-slide {
    flex: 0 0 calc((100% - 40px) / 3);
    min-width: 0;
  }
  @media (max-width: 720px) {
    .page-404__carousel-slide { flex: 0 0 calc(100% - 0px); }
  }
  .page-404__product-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .page-404__product-img-wrapper {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: #f5f5f5;
    margin-bottom: 10px;
  }
  .page-404__product-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .page-404__product-card:hover .page-404__product-img-wrapper img {
    transform: scale(1.04);
  }
  .page-404__product-title {
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0;
    text-align: center;
  }

  .page-404__carousel-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
  }
  .page-404__carousel-btn:hover { background: #f5f5f5; border-color: #bbb; }
  .page-404__carousel-btn:disabled { opacity: 0.3; cursor: default; }

  .page-404__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }
  .page-404__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ddd;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }
  .page-404__dot.is-active { background: #111; }

  /* ── Categories ── */
  .page-404__categories-section { margin-bottom: 20px; }
  .page-404__categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 600px) {
    .page-404__categories { grid-template-columns: 1fr; }
  }
  .page-404__cat-tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    background: #222;
  }
  .page-404__cat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
    transition: opacity 0.3s, transform 0.3s;
  }
  .page-404__cat-tile:hover .page-404__cat-img {
    opacity: 0.6;
    transform: scale(1.04);
  }
  .page-404__cat-label {
    position: absolute;
    bottom: 16px;
    left: 16px;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }
</style>

<script>
(function () {
  var carousel   = document.querySelector('[data-carousel]');
  if (!carousel) return;

  var track      = carousel.querySelector('[data-carousel-track]');
  var slides     = Array.from(track.querySelectorAll('.page-404__carousel-slide'));
  var prevBtn    = carousel.querySelector('[data-carousel-prev]');
  var nextBtn    = carousel.querySelector('[data-carousel-next]');
  var dotsWrap   = document.querySelector('[data-carousel-dots]');

  var perPage    = window.innerWidth <= 720 ? 1 : 3;
  var current    = 0;
  var total      = Math.ceil(slides.length / perPage);

  // Build dots
  for (var i = 0; i < total; i++) {
    var dot = document.createElement('button');
    dot.className = 'page-404__dot' + (i === 0 ? ' is-active' : '');
    dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
    dot.dataset.index = i;
    dotsWrap.appendChild(dot);
  }

  function goTo(index) {
    current = Math.max(0, Math.min(index, total - 1));
    var slideWidth = slides[0].offsetWidth + 20; // gap = 20px
    track.style.transform = 'translateX(-' + (current * perPage * slideWidth) + 'px)';
    dotsWrap.querySelectorAll('.page-404__dot').forEach(function (d, i) {
      d.classList.toggle('is-active', i === current);
    });
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current === total - 1;
  }

  prevBtn.addEventListener('click', function () { goTo(current - 1); });
  nextBtn.addEventListener('click', function () { goTo(current + 1); });
  dotsWrap.addEventListener('click', function (e) {
    if (e.target.classList.contains('page-404__dot')) goTo(parseInt(e.target.dataset.index));
  });

  goTo(0);

  window.addEventListener('resize', function () {
    perPage = window.innerWidth <= 720 ? 1 : 3;
    total   = Math.ceil(slides.length / perPage);
    goTo(0);
  });
})();
</script>

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oops! Page not found"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "The page you're looking for doesn't exist. Check out our products below!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Back to Home"
    },
    {
      "type": "header",
      "content": "Featured products carousel"
    },
    {
      "type": "text",
      "id": "carousel_heading",
      "label": "Carousel heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Collection to pull products from"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 9
    },
    {
      "type": "header",
      "content": "Shop by Category"
    },
    {
      "type": "text",
      "id": "categories_heading",
      "label": "Section heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "cat1_title",
      "label": "Category 1 title",
      "default": "Clothing"
    },
    {
      "type": "collection",
      "id": "cat1_collection",
      "label": "Category 1 collection"
    },
    {
      "type": "image_picker",
      "id": "cat1_image",
      "label": "Category 1 image"
    },
    {
      "type": "text",
      "id": "cat2_title",
      "label": "Category 2 title",
      "default": "Skate"
    },
    {
      "type": "collection",
      "id": "cat2_collection",
      "label": "Category 2 collection"
    },
    {
      "type": "image_picker",
      "id": "cat2_image",
      "label": "Category 2 image"
    },
    {
      "type": "text",
      "id": "cat3_title",
      "label": "Category 3 title",
      "default": "Accessories"
    },
    {
      "type": "collection",
      "id": "cat3_collection",
      "label": "Category 3 collection"
    },
    {
      "type": "image_picker",
      "id": "cat3_image",
      "label": "Category 3 image"
    }
  ]
}
{% endschema %}